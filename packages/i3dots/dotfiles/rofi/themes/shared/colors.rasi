* {
    background:     #1c0f19FF;
    background-alt: #564050FF;
    foreground:     #f4dceaFF;
    selected:       #ffacedFF;
    active:         #ffacedFF;
    urgent:         #ffb4abFF;
    BG:             #1c0f19FF;
    BGA:            #564050FF;
    FG:             #f4dceaFF;
    SEL:            #ffacedFF;
    BDR:            #a4899bFF;
    ON:             #ffacedFF;
    OFF:            #ffb4abFF;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

element-text selected {
    text-color:       var(background);
}

element-icon selected {
    text-color:       var(background);
}
