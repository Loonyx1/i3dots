* {
    background:     #1e0f0eFF;
    background-alt: #5c403dFF;
    foreground:     #fadcd8FF;
    selected:       #ffb4abFF;
    active:         #ffb4abFF;
    urgent:         #ffb4abFF;
    BG:             #1e0f0eFF;
    BGA:            #5c403dFF;
    FG:             #fadcd8FF;
    SEL:            #ffb4abFF;
    BDR:            #ab8884FF;
    ON:             #ffb4abFF;
    OFF:            #ffb4abFF;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

element-text selected {
    text-color:       var(background);
}

element-icon selected {
    text-color:       var(background);
}
