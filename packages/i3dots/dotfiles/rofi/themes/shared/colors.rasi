* {
    background:     #131316FF;
    background-alt: #47464eFF;
    foreground:     #e5e1e6FF;
    selected:       #c3c2f7FF;
    active:         #c6c4dcFF;
    urgent:         #ffb4abFF;
    BG:             #131316FF;
    BGA:            #47464eFF;
    FG:             #e5e1e6FF;
    SEL:            #c3c2f7FF;
    BDR:            #918f99FF;
    ON:             #c6c4dcFF;
    OFF:            #ffb4abFF;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

element-text selected {
    text-color:       var(background);
}

element-icon selected {
    text-color:       var(background);
}
