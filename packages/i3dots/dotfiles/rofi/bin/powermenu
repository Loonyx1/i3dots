#!/usr/bin/env bash
rofi_command="rofi -theme $HOME/.config/rofi/themes/powermenu.rasi"

uptime=$(uptime -p | sed -e 's/up //g')

# Options
if [[ "$DIR" == "powermenus" ]]; then
	shutdown="⏻"
	reboot=""
	suspend=""
	logout="󰿅"
	ddir="$HOME/.config/rofi/config"
else

	# Buttons
	layout=`cat $HOME/.config/rofi/themes/powermenu.rasi | grep BUTTON | cut -d'=' -f2 | tr -d '[:blank:],*/'`
	if [[ "$layout" == "TRUE" ]]; then
		shutdown="⏻"
		reboot=""
		suspend=""
		logout="󰿅"
	else
		shutdown="⏻ Shutdown"
		reboot=" Restart"
		suspend=" Sleep"
		logout="󰿅 Logout"
	fi
	ddir="$HOME/.config/rofi/themes"
fi


# Variable passed to rofi
options="$suspend\n$logout\n$reboot\n$shutdown"

if command -v systemctl >/dev/null 2>&1; then
    CMD_POWEROFF="systemctl poweroff"
    CMD_REBOOT="systemctl reboot"
    CMD_SUSPEND="systemctl suspend"
else
    CMD_POWEROFF="loginctl poweroff"
    CMD_REBOOT="loginctl reboot"
    CMD_SUSPEND="loginctl suspend"
fi

chosen="$(echo -e "$options" | $rofi_command -p "UP - $uptime" -dmenu -selected-row 0)"
case $chosen in
    $shutdown)
		$CMD_POWEROFF
        ;;
    $reboot) 
		$CMD_REBOOT
        ;;
    $suspend)
		mpc -q pause
		amixer set Master mute
		sh $HOME/.local/bin/lock
		$CMD_SUSPEND
        ;;
    $logout)
		loginctl terminate-session "$(loginctl list-sessions | awk '/$(whoami)/{print $1}' | head -n 1)"
        ;;
esac

