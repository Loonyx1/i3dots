# Variación para Void Linux
export PKG_MANAGER="xbps-install"
export PKG_UPDATE_CMD="-Syu"
export PKG_INSTALL_CMD="-Sy"
export PKG_QUERY_CMD="xbps-query -l | sed -E 's/^ii //; s/-[0-9].*//'"
export PKG_LIST="i3 pcmanfm-qt polybar rofi kitty picom qt6ct lxappearance feh dex xfce-polkit pipewire wireplumber pulseaudio-utils setxkbmap brightnessctl playerctl maim xclip xdotool dmenu git curl wget unzip base-devel cargo pkg-config openssl-devel libxcb-devel xcb-util-devel xcb-util-image-devel xcb-util-keysyms-devel xcb-util-renderutil-devel xcb-util-wm-devel libxkbcommon-devel font-awesome6 fontconfig ImageMagick papirus-icon-theme"

export POLKIT_AGENT="/usr/libexec/xfce-polkit"
export I3_FONT="JetBrainsMono Nerd Font"
export OS_ICON=""

export POWERMENU_CMD_SHUTDOWN="loginctl poweroff"
export POWERMENU_CMD_REBOOT="loginctl reboot"
export POWERMENU_CMD_SUSPEND="loginctl suspend"
