# Variación para Void Linux
export PKG_MANAGER="sudo xbps-install"
export PKG_INSTALL_CMD="-Syu && sudo xbps-install -y"
export PKG_LIST="i3 polybar rofi kitty picom qt6ct lxappearance feh dex polkit-gnome pipewire wireplumber pulseaudio-utils setxkbmap brightnessctl playerctl maim xclip xdotool nemo dmenu git curl wget unzip base-devel cargo pkg-config openssl-devel libxcb-devel xcb-util-devel xcb-util-image-devel xcb-util-keysyms-devel xcb-util-renderutil-devel xcb-util-wm-devel libxkbcommon-devel font-awesome6 fontconfig ImageMagick"

export POLKIT_AGENT="/usr/libexec/polkit-gnome-authentication-agent-1"
export I3_FONT="JetBrainsMono Nerd Font"
export OS_ICON=""

export POWERMENU_CMD_SHUTDOWN="loginctl poweroff"
export POWERMENU_CMD_REBOOT="loginctl reboot"
export POWERMENU_CMD_SUSPEND="loginctl suspend"
