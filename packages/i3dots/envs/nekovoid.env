# Variación para NekoVoid Linux (ISO / Offline)
export PKG_MANAGER="sudo xbps-install"
export PKG_INSTALL_CMD="-Syu && sudo xbps-install -y"
export PKG_LIST="" # Paquetes ya se instalan por mklive

export POLKIT_AGENT="/usr/libexec/polkit-gnome-authentication-agent-1"
export I3_FONT="JetBrainsMono Nerd Font"
export OS_ICON=""

export POWERMENU_CMD_SHUTDOWN="loginctl poweroff"
export POWERMENU_CMD_REBOOT="loginctl reboot"
export POWERMENU_CMD_SUSPEND="loginctl suspend"

# Opciones offline
export SKIP_SYSTEM_PKGS=1
export SKIP_FONTS_DOWNLOAD=1
export SKIP_THEMES_DOWNLOAD=1
export SKIP_MATUGEN_DOWNLOAD=1
