# Configuración de Paquete: i3dots
# Este archivo es cargado por dots

export WALLPAPER_DIR="$HOME/wall"
export ROFI_THEME="$HOME/.config/rofi/themes/launcher.rasi"
export WALL_SEL_THEME="$HOME/.config/rofi/themes/WallSelect.rasi"

# Persistencia Local
export LAST_WALLPAPER_PATH_FILE="$HOME/.config/i3/wall"
export CURRENT_WALLPAPER_LINK="$HOME/.config/i3/current"

# Motor de wallpaper
export WP_ENGINE="feh"

# Directorios de Lógica del Paquete
export HOOK_DIR="$PACKAGE_DIR/hooks"

# Configuración de Polybar
export POLYBAR_CONFIG_DIR="$HOME/.config/polybar"
export POLYBAR_LAUNCH_SCRIPT="$POLYBAR_CONFIG_DIR/launch.sh"

# Configuración de i3
export I3_CONFIG_DIR="$HOME/.config/i3"

# Secuencias de ejecución
export DOT_SEQUENCE=(
    "wp_select.sh"
    "engine_matugen.sh -D -T scheme-fidelity -P saturation"
    "apply_dots.sh"
)

# Secuencia para solo recargar (sin menú de wallpaper)
export DOT_SEQUENCE_RELOAD=(
    "engine_matugen.sh -D -T scheme-fidelity -P saturation"
    "apply_dots.sh"
)

# Configuración para el selector de wallpaper (wp_select.sh)
export WP_SEL_BIN="rofi"
export WP_SEL_ARGS="-dmenu -p Wallpaper -theme $WALL_SEL_THEME"
export WP_SEL_STYLE="-theme-str 'element-icon{size:450px;} element-text{horizontal-align:0.5;}'"
export WP_SEL_LINE_TMPL='%f\x00icon\x1f%p'

# Configuración para el módulo core launcher
export LAUNCHER_BIN="rofi"
export LAUNCHER_ARGS="-show drun -theme $PACKAGE_DIR/dotfiles/rofi/themes/launcher.rasi"

# Configuración para el módulo core powermenu
export POWERMENU_BIN="rofi"
export POWERMENU_ARGS="-theme $PACKAGE_DIR/dotfiles/rofi/themes/powermenu.rasi"
export POWERMENU_LABEL_SHUTDOWN="⏻"
export POWERMENU_LABEL_REBOOT=""
export POWERMENU_LABEL_SUSPEND=""
export POWERMENU_LABEL_LOGOUT="󰿅"
export POWERMENU_CMD_LOGOUT="i3-msg exit"

# Selector de Barra
export BAR_SEL_THEME="$PACKAGE_DIR/dotfiles/rofi/themes/bar_selector.rasi"
export BAR_DEFAULT_TYPE="polybar_antigua"

# --- CARGA DE VARIANTES ---
if [ -f "$PACKAGE_DIR/.current_variant" ]; then
    VARIANT_NAME=$(cat "$PACKAGE_DIR/.current_variant")
    [ -f "$PACKAGE_DIR/envs/${VARIANT_NAME}.env" ] && source "$PACKAGE_DIR/envs/${VARIANT_NAME}.env"
fi

export MANAGED_COMPONENTS="polybar i3 display"

# Mapeo de Componentes
export COMPONENT_POLYBAR="system.ini"
export COMPONENT_I3="config"
export COMPONENT_DISPLAY="resolution"

# Configuración del Selector de Resolución (engine_display.sh)
export DISP_SEL_THEME="$PACKAGE_DIR/dotfiles/rofi/themes/display_selector.rasi"
export DISP_CONF_THEME="$PACKAGE_DIR/dotfiles/rofi/themes/display_confirm.rasi"
export DISP_SEL_BIN="rofi"
export DISP_SEL_ARGS="-dmenu -theme $DISP_SEL_THEME"
export DISP_CONF_ARGS="-dmenu -theme $DISP_CONF_THEME"
export DISP_INIT_POST_APPLY="false"
export DISP_GLYPH_MONITOR="󰍹 "
export DISP_GLYPH_RESOLUTION="󰘚 "
export DISP_GLYPH_RATE="󱎫 "
export DISP_GLYPH_SCALE="󰹯 "
export DISP_GLYPH_CONFIRM="󰗹 "

# Prompts y Cadenas de UI (Traducción y Personalización)
export DISP_PROM_MAIN="Configuración de Pantalla"
export DISP_PROM_TIMEOUT="Tiempo de Confirmación"
export DISP_PROM_MONITOR="Pantalla"
export DISP_PROM_RESOLUTION="Resolución"
export DISP_PROM_RATE="Frecuencia"
export DISP_PROM_SCALE="Escala"
export DISP_PROM_CONFIRM="¿Mantener resolución?"
export DISP_PROM_MSG="Se revertirá automáticamente tras %s segundos de inactividad."
export DISP_PROM_MENU_OUTPUT="1. Pantalla"
export DISP_PROM_MENU_RES="2. Resolución"
export DISP_PROM_MENU_RATE="3. Frecuencia"
export DISP_PROM_MENU_SCALE="4. Escala"
export DISP_PROM_MENU_TIME="5. Tiempo Confirmación"
export DISP_PROM_MENU_APPLY="6. [ Aplicar y Probar ]"
export DISP_PROM_MENU_CANCEL="7. [ Cancelar y Salir ]"
export DISP_PROM_VAL_NONE="No seleccionada"
export DISP_PROM_VAL_AUTO="Auto"
export DISP_PROM_TIMES="5s\n10s\n15s\n30s\n60s"
export DISP_PROM_SCALES="0.5\n0.75\n1.0\n1.25\n1.5\n1.75\n2.0\n2.5\n3.0\npersonalizada"
export DISP_UNIT_RATE=" Hz"
export DISP_VAL_CONFIRM="Confirmar"
export DISP_VAL_REVERT="Revertir"

# Secuencia para cambiar de resolución
export DOT_SEQUENCE_DISPLAY=(
    "engine_display.sh"
)

# Configuración de Bar
export BAR_STYLE="square"
export BAR_POSITION="bottom"  # Opciones: top, bottom
export BAR_TRANSPARENCY="true" # Opciones: true, false
export BAR_HEIGHT="15pt"

# Catálogo de Presets de Barra para Ciclo Rápido
export BAR_PRESETS="Principal: -b polybar_antigua -t true | flotante:-b polybar_floating -m solid -t true | Subrayado:-b polybar_underline -m underline -t false | Subrayado-solid:-b polybar_underline -m solid -t false | Compacto:-b polybar_compact"

# Atajos de Secuencias

export DOT_SEQUENCE_BAR=(
    "engine_bar.sh"
)
