{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2
    },
    "width": 13
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    }
  },
  "modules": [
    { "type": "os", "key": "OS ", "format": "{3} Linux" },
    { "type": "kernel", "key": "KER", "format": "Linux {2}" },
    { "type": "shell", "key": "SH ", "format": "{1} {4}" },
    { "type": "wm", "key": "WM ", "format": "{1}" },
    { "type": "packages", "key": "PKG", "format": "{1}" },
    "break",
    {
      "type": "custom",
      "format": "{##{{colors.surface.default.hex_stripped}}}■ {##{{colors.error.default.hex_stripped}}}■ {##{{colors.primary.default.hex_stripped}}}■ {##{{colors.tertiary.default.hex_stripped}}}■ {##{{colors.secondary.default.hex_stripped}}}■ {##{{colors.secondary_container.default.hex_stripped}}}■ {##{{colors.tertiary_container.default.hex_stripped}}}■ {##{{colors.on_surface.default.hex_stripped}}}■"
    },
    {
      "type": "custom",
      "format": "{##{{colors.outline.default.hex_stripped}}}■ {##{{colors.error_container.default.hex_stripped}}}■ {##{{colors.primary_container.default.hex_stripped}}}■ {##{{colors.tertiary.default.hex_stripped}}}■ {##{{colors.secondary.default.hex_stripped}}}■ {##{{colors.on_secondary_container.default.hex_stripped}}}■ {##{{colors.on_tertiary_container.default.hex_stripped}}}■ {##{{colors.on_surface.default.hex_stripped}}}■"
    }
  ]
}
