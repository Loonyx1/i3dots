* {
    background:     #131318FF;
    background-alt: #47464fFF;
    foreground:     #e4e1e9FF;
    selected:       #c2c1ffFF;
    selected-neutral: #e4e1e926;
    active:         #c6c4ddFF;
    urgent:         #ffb4abFF;
    BG:             #131318FF;
    BGA:            #47464fFF;
    FG:             #e4e1e9FF;
    SEL:            #c2c1ffFF;
    BDR:            #918f9aFF;
    ON:             #c6c4ddFF;
    OFF:            #ffb4abFF;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

element-text selected {
    text-color:       var(background);
}

element-icon selected {
    text-color:       var(background);
}
