#!/usr/bin/env bash

# Exportar variables y entorno
export PATH="$HOME/.cargo/bin:$PATH"
WALLPAPER_DIR="$HOME/wall"

# Obtener lista de wallpapers para Rofi
wallpapers=$(find "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort)
options=""
while IFS= read -r file; do
    filename=$(basename "$file")
    options+="$filename\x00icon\x1f$file\n"
done <<< "$wallpapers"

# Ejecutar Rofi y guardar la selección
selected_wallpaper=$(echo -e "$options" | rofi -dmenu -theme "$HOME/.config/rofi/themes/WallSelect.rasi" -theme-str 'element-icon{size: 450px;}' "")

# Si el usuario seleccionó algo (no presionó Esc)
if [[ -n "$selected_wallpaper" ]]; then
    
    # Forma más segura y rápida de obtener la ruta completa
    wallpaper_path="$WALLPAPER_DIR/$selected_wallpaper"
    echo "wallpaper: $wallpaper_path" >> /tmp/wallselect.log
    
    # Matugen corregido: usando el PATH directamente y forzando saturacion para evitar prompt
    matugen image "$wallpaper_path" --mode dark --prefer saturation >> /tmp/wallselect.log 2>&1
    echo "matugen done" >> /tmp/wallselect.log
    
    # Aplicar fondo de pantalla
    feh --bg-fill "$wallpaper_path" >> /tmp/wallselect.log 2>&1
    echo "$wallpaper_path" > ~/.cache/wal/wal
   
    # Recargar configuraciones de terminal y barra
    kill -SIGUSR1 $(pgrep kitty) 2>/dev/null
    pkill polybar
    sleep 0.5
    bash ~/.config/polybar/launch.sh >> /tmp/wallselect.log 2>&1
    echo "polybar done" >> /tmp/wallselect.log

fi
